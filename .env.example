# Образец настроек. Скопируйте в .env и заполните; .env не попадает в репозиторий и в образ.
#   cp .env.example .env
# Все значения здесь условные. Настоящий ключ записывается только в .env.

# --- Модель для полной проверки (обязательно для SVERKA_RUN_MODE=live) ---
# Любой OpenAI-совместимый адрес. Пример для DeepSeek, подробности в docs/harness.md.
SVERKA_PROVIDER_NAME=deepseek
SVERKA_PROVIDER_BASE_URL=https://api.deepseek.com
SVERKA_PROVIDER_MODEL=deepseek-flash
SVERKA_PROVIDER_API_KEY=
SVERKA_PROVIDER_MAX_TOKENS_FIELD=max_tokens
SVERKA_PROVIDER_THINKING=enabled
# Пустое значение отключает передачу температуры (нужно для режима размышления DeepSeek).
SVERKA_PROVIDER_TEMPERATURE=
# Таймаут одного запроса к модели, с.
SVERKA_PROVIDER_TIMEOUT=120

# --- Режим и порт ---
# live: полная проверка через модель; disabled: проверка сразу завершается ошибкой;
# fixture: синтетический пример результата для разработки интерфейса.
SVERKA_RUN_MODE=live
SVERKA_PORT=8000

# --- Лимиты одной проверки (необязательно; пусто = значения по умолчанию, docs/harness.md) ---
# Запросов к модели и вызовов инструментов на один документ.
SVERKA_HARNESS_DOC_MAX_REQUESTS=
SVERKA_HARNESS_DOC_MAX_TOOL_CALLS=
# Время на один документ, с.
SVERKA_HARNESS_DOC_MAX_SECONDS=
# Запросов, вызовов инструментов и времени (с) на всю проверку.
SVERKA_HARNESS_RUN_MAX_REQUESTS=
SVERKA_HARNESS_RUN_MAX_TOOL_CALLS=
SVERKA_HARNESS_RUN_MAX_SECONDS=
# Время на один запрос к модели, с, и число повторов после сбоя.
SVERKA_HARNESS_REQUEST_SECONDS=
SVERKA_HARNESS_PROVIDER_RETRIES=
# Повторных раундов после первой проверки предложения.
SVERKA_HARNESS_MAX_REINSPECTION_ROUNDS=

# --- Сверка и распознавание (необязательно) ---
SVERKA_TOLERANCE=0.01
SVERKA_OCR_LANG=rus+eng
SVERKA_OCR_DPI=300
SVERKA_MAX_UPLOAD_MB=200
